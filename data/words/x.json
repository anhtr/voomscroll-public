"xin lỗi": {"etymology":[{"vi":"xin"}," (“to beg”) + ",{"vi":"lỗi"}," (“mistake”)."],"pos":[{"name":"Verb","senses":[{"gloss":["to apologise"]}]},{"name":"Interjection","senses":[{"gloss":["I'm sorry (for my mistake/transgression)"],"examples":[{"vi":"Xin lỗi, tớ không cố ý.","en":"Sorry, I didn't mean to do that."}]},{"gloss":["excuse me/pardon me (for intruding/disturbing you)"],"labels":["polite"],"examples":[{"vi":"Xin lỗi, cho hỏi đây có phải là nhà anh Tiến không ạ?","en":"Excuse me, is this Mr. Tiến's address?"}]}]}],"usage_notes":[["For the English phrase I'm sorry, translators may use ",{"vi":"rất tiếc / tiếc quá"}," (“that's a pity”) or ",{"vi":"xin chia buồn với..."}," (“my condolences to...”)."],[{"vi":"Rất tiếc, chúng tôi hết phòng đôi rồi ạ."}," ― I'm sorry, we have run out of twin rooms."],["To ask for pardon and understanding in more mild contexts, ",{"vi":"xin bỏ qua"}," (“forgive”) or ",{"vi":"xin thông cảm"}," (“sympathize”) may be used instead."],[{"vi":"Nếu video có gì sai sót mong quý khán thính giả bỏ qua."}," ― If there are any errors in this video, I hope the audience will forgive."],[{"vi":"Xin thông cảm mình đã trễ vì sáng nay bị kẹt xe."}," ― Please be understanding for having been late because of traffic this morning."]]},
