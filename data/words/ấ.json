"ấy": {"etymology":["Diachronically, this is probably a Northern Vietnamese innovation occured some time between the stages of Proto-Vietnamese and attested Northern Old Vietnamese. It is amply attested in the oldest Nôm texts (which are all in Northern Old Vietnamese or its offshoot(s)), yet has no cognate in the Muong lects, and usage of this morpheme by Central and Southern speakers clearly indicates borrowing. It also does not neatly fit into Proto-Vietnamese demonstrative paradigm with its zero-initial."],"pos":[{"name":"Determiner","senses":[{"gloss":["that; those"],"labels":["chiefly","Northern Vietnam"]}]},{"name":"Particle","senses":[{"gloss":["sentence-ending intensifying particle"],"labels":["chiefly","northern Vietnam"],"syn":["đó"]}]},{"name":"Pronoun","senses":[{"gloss":["you, my buddy/gal"],"labels":["northern Vietnam","humorous"],"syn":["đằng ấy"]}]}]},
"ấn": {"pos":[{"name":"Verb","etymology":["Sino-Vietnamese word from ",{"han":"按"}," (“to push with hands, to press”)."],"senses":[{"gloss":["to press with one's finger"],"syn":["nhấn","bấm"]}]},{"name":"Noun","etymology":["Sino-Vietnamese word from ",{"han":"印"},"."],"senses":[{"gloss":["seal"],"labels":["archaic","device"]}],"syn":["dấu"]},{"name":"Verb","senses":[{"gloss":["to print"]}]}]},
"ấn hành": {"etymology":["Sino-Vietnamese word from ",{"han":"印行"},"."],"pos":[{"name":"Verb","senses":[{"gloss":["to publish (by print)"],"labels":["somewhat","dated"]}]}]},
"ấn định": {"etymology":["Sino-Vietnamese word from ",{"han":"印定"},", composed of ",{"han":"印"}," and ",{"han":"定"},"."],"pos":[{"name":"Verb","senses":[{"gloss":["to decide (on); to determine"],"examples":[{"vi":"ấn định ngày phát hành","en":"to decide on the publish date"}]}]}]},
"ấn chương": {"etymology":["Sino-Vietnamese word from ",{"han":"印章"}," (“seal”)."],"pos":[{"name":"Noun","senses":[{"gloss":["seal"],"labels":["historical"]}],"syn":["triện"]}]},
"ấn tượng": {"etymology":["Sino-Vietnamese word from ",{"han":"印象"},", composed of ",{"han":"印"}," (“to imprint; to press”) and ",{"han":"象"}," (“imagery; form; state”), Japanese ",{"han":"印象"}," (inshō), Middle Chinese ",{"han":"印象"}," (“reflection”)."],"pos":[{"name":"Noun","senses":[{"gloss":["impression"]}]},{"name":"Adjective","senses":[{"gloss":["impressive"]}]}]}
}}
